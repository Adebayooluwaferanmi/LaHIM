    "coding": "87675-5",
    "text": "Parent Patient Activation Measure - 13 [PAM] Parent"
  },
  {
    "coding": "87676-3",
    "text": "When all is said and done, I am the person who is responsible for taking care of my child's health Parent [PAM]"
  },
  {
    "coding": "87677-1",
    "text": "Taking an active role in my child's health care is the most important thing that affects his/her health Parent [PAM]"
  },
  {
    "coding": "87678-9",
    "text": "I am confident I can help prevent or reduce problems associated with my child's health Parent [PAM]"
  },
  {
    "coding": "87679-7",
    "text": "I know what each of my child's prescribed medications do Parent [PAM]"
  },
  {
    "coding": "87680-5",
    "text": "I am confident that I can tell whether I need to go to the doctor or whether I can take care of my child's health problem myself Parent [PAM]"
  },
  {
    "coding": "87681-3",
    "text": "I am confident that I can tell a doctor concerns I have abou my child's health even when he or she does not ask Parent [PAM]"
  },
  {
    "coding": "87682-1",
    "text": "I am confident that I can follow through on medical treatments I need to do for my child at home Parent [PAM]"
  },
  {
    "coding": "87683-9",
    "text": "I understand my child's health problems and what causes them Parent [PAM]"
  },
  {
    "coding": "87684-7",
    "text": "I know what treatments are available for my child's health problems Parent [PAM]"
  },
  {
    "coding": "87685-4",
    "text": "I have been able to help my child maintain (keep up with) lifestyle changes, like eating right or exercising Parent [PAM]"
  },
  {
    "coding": "87686-2",
    "text": "I know how to prevent problems with my child's health Parent [PAM]"
  },
  {
    "coding": "87687-0",
    "text": "I am confident I can figure out solutions when new problems arise with my child's health Parent [PAM]"
  },
  {
    "coding": "87688-8",
    "text": "I am confident that I can help my child maintain lifestyle changes, like eating right and exercising, even during times of stress Parent [PAM]"
  },
