    "coding": "46577-3",
    "text": "Management of equipment Caregiver [OASIS]"
  },
  {
    "coding": "87690-4",
    "text": "When all is said and done, I am responsible for seeing that this person's health is managed properly Caregiver [PAM]"
  },
  {
    "coding": "87691-2",
    "text": "Taking an active role in this person's health care is one of the most important factors in determining her/his health and ability to function Caregiver [PAM]"
  },
  {
    "coding": "87692-0",
    "text": "I am confident that I can take actions that will help prevent or minimize some symptoms or problems associated with this person's health Caregiver [PAM]"
  },
  {
    "coding": "87693-8",
    "text": "I know what each of this person's prescribed medications do Caregiver [PAM]"
  },
  {
    "coding": "87694-6",
    "text": "I am confident that I can tell when this person needs to get medical care and when I can handle the problem myself Caregiver [PAM]"
  },
  {
    "coding": "87695-3",
    "text": "I am confident I can tell a doctor the concerns that I have about this person's health even when he or she does not ask Caregiver [PAM]"
  },
  {
    "coding": "87696-1",
    "text": "I am confident that I can follow through on medical treatments I need to do for this person at home Caregiver [PAM]"
  },
  {
    "coding": "87697-9",
    "text": "I understand the nature and causes of this person's health Caregiver [PAM]"
  },
  {
    "coding": "87698-7",
    "text": "I know the different medical treatment options available for this person's health Caregiver [PAM]"
  },
  {
    "coding": "87699-5",
    "text": "I am able to help this person maintain lifestyle changes (like eating right or exercising) for her/his condition Caregiver [PAM]"
  },
  {
    "coding": "87700-1",
    "text": "I know how to prevent problems with this person's health Caregiver [PAM]"
  },
  {
    "coding": "87701-9",
    "text": "I am confident I can figure out solutions when new situations or problems arise with this person's health Caregiver [PAM]"
  },
  {
    "coding": "87702-7",
    "text": "I am confident I can help this person with lifestyle changes, like diet and exercise, even during times of stress Caregiver [PAM]"
  },
