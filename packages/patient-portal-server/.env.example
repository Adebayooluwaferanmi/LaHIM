# Patient Portal Server Environment Configuration

# Database
PORTAL_DATABASE_URL=postgresql://user:password@localhost:5432/patient_portal

# JWT Authentication
PATIENT_PORTAL_JWT_SECRET=change-me-to-a-secure-random-secret

# Service Integration
PORTAL_SERVICE_TOKEN=change-me-service-token

# Frontend URL (for CORS and email links)
PATIENT_PORTAL_FRONTEND_URL=http://localhost:3002

# Server Port
PORT=4001

# Email Configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@lahim.io

# Optional: For development, you can disable email sending
# EMAIL_ENABLED=false


