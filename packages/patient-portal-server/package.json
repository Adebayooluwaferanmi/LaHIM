{
  "name": "@lahim/patient-portal-server",
  "version": "0.1.0",
  "description": "Patient Portal & External Consultation API service for LaHIM",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "start": "node dist/index.js",
    "dev": "nodemon -w src -e ts --exec \"npm run build && npm start\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "npm exec vitest -- run",
    "test:watch": "npm exec vitest"
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "nodemailer": "^6.9.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.14",
    "nodemon": "~2.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^1.6.0"
  }
}


