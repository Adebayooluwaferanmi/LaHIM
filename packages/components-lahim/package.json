{
  "name": "@lahim/components",
  "version": "1.0.0",
  "description": "Modern React components for LaHIM LIMS - Compatible with React 18 and Bootstrap 4",
  "main": "./dist/index.js",
  "module": "./dist/index.esm",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scss/main.scss": "./dist/scss/main.scss"
  },
  "files": [
    "dist",
    "scss"
  ],
  "scripts": {
    "build": "vite build && npm run copy:scss",
    "copy:scss": "node -e \"const fs=require('fs');fs.cpSync('scss','dist/scss',{recursive:true})\"",
    "dev": "vite build --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "components",
    "bootstrap",
    "lims"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Adebayooluwaferanmi/LaHIM.git",
    "directory": "packages/components-lahim"
  },
  "author": "LaHIM Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Adebayooluwaferanmi/LaHIM/issues"
  },
  "homepage": "https://github.com/Adebayooluwaferanmi/LaHIM#readme",
  "peerDependencies": {
    "bootstrap": "~4.4.1",
    "react": "^18.3.0",
    "react-bootstrap": "^2.10.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.0",
    "@fortawesome/free-regular-svg-icons": "^6.5.0",
    "@fortawesome/free-solid-svg-icons": "^6.5.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "classnames": "^2.3.2",
    "date-fns": "^3.6.0",
    "react-bootstrap-typeahead": "^6.0.0",
    "react-datepicker": "^4.25.0",
    "react-spinners": "^0.13.8",
    "react-toastify": "^9.1.3"
  },
  "devDependencies": {
    "@types/classnames": "^2.3.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-bootstrap": "^2.10.0",
    "react-dom": "^18.3.0",
    "rimraf": "^5.0.5",
    "sass": "^1.77.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0"
  }
}
