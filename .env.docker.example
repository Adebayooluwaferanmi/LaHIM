# Copy to .env.docker in this folder:  cp .env.docker.example .env.docker
#
# Boot-first core baseline (from LaHIM/):
#   ./scripts/docker-build-native.sh lahim-server
#   ./scripts/docker-up-native.sh postgres redis couchdb lahim-server
#   ./scripts/verify-core-baseline.sh
#   ./scripts/docker-build-native.sh staff-frontend
#   ./scripts/docker-up-native.sh staff-frontend
#
# URLs: staff UI http://localhost:3001  ·  API http://localhost:3000
#       portal UI http://localhost:4002  ·  portal API http://localhost:4001
#
# GKE later: map the same boundaries — Namespace/NetworkPolicy so the portal
# workload cannot reach CouchDB/Redis; only Postgres + core Service URL.

# Core ↔ portal integration (must match on both sides)
PORTAL_SERVICE_TOKEN=change-me-long-random-token
PATIENT_PORTAL_JWT_SECRET=change-me-long-random-jwt-secret

# Optional: override public URLs (browser uses host ports, not Docker DNS)
# FRONTEND_URL=http://localhost:3001
# PATIENT_PORTAL_FRONTEND_URL=http://localhost:4002
# VITE_LAHIM_API=http://localhost:3000
# VITE_HOSPITALRUN_API=http://localhost:3000
# VITE_PORTAL_API_URL=http://localhost:4001
