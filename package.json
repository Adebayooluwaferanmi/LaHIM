{
  "name": "lahim",
  "version": "2.0.0",
  "description": "LaHIM mono-repo",
  "repository": "git@github.com:Adebayooluwaferanmi/LaHIM.git",
  "author": "LaHIM Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "echo 'No root tests'",
    "test:all": "npm run test:ci --workspace=@lahim/frontend && npm run test --workspace=@lahim/server && npm run test --workspace=@lahim/patient-portal-server && npm run test --workspace=@lahim/cli && npm run test --workspace=@lahim/components",
    "commit": "npx git-cz",
    "dev:db": "docker compose up -d couchdb",
    "dev:server": "npm run --workspace=@lahim/server dev:start",
    "dev:frontend": "npm run --workspace=@lahim/frontend start",
    "dev:portal-server": "npm run --workspace=@lahim/patient-portal-server dev",
    "dev:portal-frontend": "npm run --workspace=@lahim/patient-portal-frontend dev",
    "build:frontend": "npm run --workspace=@lahim/frontend build",
    "build:components": "npm run --workspace=@lahim/components build",
    "build:portal": "npm run --workspace=@lahim/patient-portal-server build; npm run --workspace=@lahim/patient-portal-frontend build",
    "build:lahim.io": "npm run build:components; npm run build:frontend; node -e \"const fs=require('fs');fs.rmSync('lahim.io',{recursive:true,force:true});fs.cpSync('packages/frontend/build','lahim.io',{recursive:true});fs.copyFileSync('lahim.io/index.html','lahim.io/404.html');fs.writeFileSync('lahim.io/.nojekyll','')\"",
    "serve:frontend": "npx serve -s packages/frontend/build -l 3001",
    "serve:lahim.io": "npx serve -s lahim.io -l 3001",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/core": "^19.6.0",
    "@commitlint/prompt": "^19.6.0",
    "commitizen": "^4.3.1",
    "commitlint-config-cz": "^0.13.2",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "dateformat": "^5.0.3",
    "husky": "^9.1.7",
    "tap": "~14.10.8",
    "vitest": "^2.1.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "workspaces": {
    "packages": [
      "packages/cli",
      "packages/components",
      "packages/components-lahim",
      "packages/frontend",
      "packages/loinc",
      "packages/patient-portal-frontend",
      "packages/patient-portal-server",
      "packages/server"
    ],
    "nohoist": [
      "**/husky",
      "**/husky/**",
      "**/jest",
      "**/jest/**",
      "**/tsdx",
      "**/tsdx/**",
      "**/cz-conventional-changelog",
      "**/cz-conventional-changelog/**",
      "**/tap",
      "**/tap/**",
      "**/tap-mocha-reporter",
      "**/tap-mocha-reporter/**",
      "**/eslint-plugin-prettier",
      "**/eslint-plugin-prettier/**",
      "**/eslint-config-prettier",
      "**/eslint-config-prettier/**",
      "**/webpack",
      "**/webpack/**"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "resolutions": {
    "@types/babel__traverse": "7.11.1",
    "parse5-parser-stream": "5.1.1",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "esprima-fb": "npm:esprima@^2.7.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.7.0",
    "@types/babel__traverse": "7.11.1"
  }
}
